# .gitignore — Terra Battle Liminal Gate share

# Resource pack (copyrighted game art — see README "Resources")
resources/
*.bin
*.bin.manifest

# Portable runtime binaries (folder + README are tracked; binaries are not)
runtime/python.exe
runtime/*.dll
runtime/*.pyd
runtime/*.zip
runtime/Lib/
runtime/Scripts/

# Personal save state / logs (never commit these)
user-data/bootstrap-state.json
user-data/events.jsonl
user-data/*.json.lock
user-data/backups/
logs/

# Client binaries
*.apk

# Build artifacts / debug
project-liminal-gate-source.tar.gz
_chkstate.py
server_json/bootstrap-state.json

# Python junk
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS junk
Thumbs.db
.DS_Store
*.bak*
